# ── Обов'язкове ──────────────────────────────────────────────
# ID категорій парфумів на OLX (через кому). Як дістати — див. README.
OLX_CATEGORY_IDS=1665,1666

# ── Railway: збереження даних ────────────────────────────────
# Примонтуй Volume на /data і став цей шлях, інакше БД злетить при редеплої.
OLX_DB=/data/olx.db

# ── Необов'язкове ────────────────────────────────────────────
# Регіон OLX (пусто = вся Україна). Рекомендую лишати пустим.
# OLX_REGION_ID=

# Розклад краулу (cron). За замовчуванням — щодня о 09:00.
CRAWL_SCHEDULE=0 9 * * *
TZ=Europe/Kyiv

# Запустити краул одразу при старті сервісу (1 = так). Зручно для першого разу.
CRAWL_ON_START=0

# Захист кнопки "Зібрати зараз". Постав будь-який секрет — без нього краул
# зможе смикнути хто завгодно, хто знає URL.
ADMIN_TOKEN=
